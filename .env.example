# NoteForge AI — Environment Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://noteforge-ai.vercel.app

# Database (PostgreSQL)
# For docker-compose network: postgresql://noteforge:noteforge_dev_pwd@db:5432/noteforge_db
# For production (Supabase / Neon / RDS): postgresql://user:password@host:5432/noteforge_db?sslmode=require
DATABASE_URL=postgresql://noteforge:noteforge_dev_pwd@db:5432/noteforge_db
POSTGRES_USER=noteforge
POSTGRES_PASSWORD=noteforge_dev_pwd
POSTGRES_DB=noteforge_db
POSTGRES_HOST_PORT=5433

# Security & Authentication (JWT)
# Generate a strong 32+ character key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Media & Storage Settings
# Options: "local" (uses persistent Docker volume uploads_data) or "supabase" or "s3"
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880

# Supabase Auth & Storage (Optional for production cloud storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=noteforge-media

# S3 / MinIO Storage (Optional)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Social OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# AI Service (Google Gemini)
# Obtain a free-tier Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# If set to True, will return structured deterministic mock responses when no key is configured
AI_MOCK_FALLBACK=True
