# NoteForge AI — Environment Configuration

# Application
ENVIRONMENT=development
DEBUG=True
PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# For docker-compose service network: postgresql://noteforge:noteforge_dev_pwd@db:5432/noteforge_db
# For local host accessing mapped port 5433: postgresql://noteforge:noteforge_dev_pwd@localhost:5433/noteforge_db
DATABASE_URL=postgresql://noteforge:noteforge_dev_pwd@db:5432/noteforge_db
POSTGRES_USER=noteforge
POSTGRES_PASSWORD=noteforge_dev_pwd
POSTGRES_DB=noteforge_db
POSTGRES_HOST_PORT=5433

# Security & Authentication
# Generate a strong 32+ character key using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Supabase / OAuth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# AI Service (Google Gemini)
# Obtain a free-tier Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# If set to True, will return structured deterministic mock responses when no key is set
AI_MOCK_FALLBACK=True
